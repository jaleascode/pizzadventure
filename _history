ion () {\n    deriva += 1\n})\n\n\n// ---------- ARRANQUE ----------\n\nmostrarMenu()"]]}]}]},{"timestamp":1786948772259,"editorVersion":"4.0.14","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":13719,"length1":0,"diffs":[[1,"const LATA_ROJA = img`\n.ffffff.\n.f1111f.\n.f2222f.\n.f2112f.\n.f2222f.\n.f2112f.\n.f2222f.\n.f2222f.\n.f2112f.\n.f2222f.\n.f2222f.\n.ffffff.\n`\nconst LATA_GOLD = img`\n.ffffff.\n.f1111f.\n.f5555f.\n.f5115f.\n.f5555f.\n.f5115f.\n.f5555f.\n.f5555f.\n.f5115f.\n.f5555f.\n.f5555f.\n.ffffff.\n`\nconst BOTELLA = img`\n..ff..\n..ff..\n.f77f.\n.f77f.\nf7777f\nf7777f\nf7117f\nf7777f\nf7777f\nf7777f\nf7777f\nffffff\n`\nconst PACHA = img`\nffffff\nf1111f\nf7777f\nf7117f\nf7777f\nf7777f\nf7777f\nf7117f\nf7777f\nf7777f\nf7777f\nffffff\n`\nconst PUERTA = img`\nffffffffffff\nf4444444444f\nf4444444444f\nf4444444444f\nf4444444444f\nf44444444f4f\nf4444444444f\nf4444444444f\nf4444444444f\nf4444444444f\nf4444444444f\nffffffffffff\n`\n"]]},{"start1":14637,"length1":0,"diffs":[[1,"const BUD = img`\n..ffffffff..\n..f111111f..\n.ffffffffff.\n.f11111111f.\n.f11111111f.\n.f22222222f.\n.f22222222f.\n.f11111111f.\n.f11111111f.\n.f11111111f.\n.f22222222f.\n.f11111111f.\n.f11111111f.\n.ffffffffff.\n`\n"]]},{"start1":14856,"length1":330,"diffs":[[1,"..ffffffff..\n..f111111f..\n.ffffffffff.\n.f55555555f.\n.f55555555f.\n.ffffffffff.\n.ffffffffff.\n.f55555555f.\n.f55555555f.\n.f55555555f.\n.ffffffffff.\n.f55555555f.\n.f55555555f.\n.ffffffffff.\n"]]},{"start1":15040,"length1":711,"diffs":[[1,""]]},{"start1":15061,"length1":330,"diffs":[[1,"..ffffffff..\n..f111111f..\n.ffffffffff.\n.f22222222f.\n.f22222222f.\n.f11111111f.\n.f11111111f.\n.f22222222f.\n.f22222222f.\n.f22222222f.\n.f11111111f.\n.f22222222f.\n.f22222222f.\n.ffffffffff.\n"]]},{"start1":15266,"length1":330,"diffs":[[1,"..ffffffff..\n..f111111f..\n.ffffffffff.\n.f55555555f.\n.f55555555f.\n.f44444444f.\n.f44444444f.\n.f55555555f.\n.f55555555f.\n.f55555555f.\n.f44444444f.\n.f55555555f.\n.f55555555f.\n